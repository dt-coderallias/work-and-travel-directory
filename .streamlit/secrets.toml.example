# Copy to .streamlit/secrets.toml for local use, or paste into the app's
# Secrets box on Streamlit Community Cloud. Never commit real values.

# The public tab, published to the web as CSV.
# For local development this can be a file path instead.
public_csv_url = "https://docs.google.com/spreadsheets/d/e/YOUR_ID/pub?gid=0&single=true&output=csv"

# The deployed Apps Script web app.
submit_url = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Must match SUBMIT_TOKEN in the Apps Script project's properties.
submit_token = "generate-a-long-random-value"
